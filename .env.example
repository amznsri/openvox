# ─── OpenVox — Local-First Configuration ───────────────────────────────────
# Copy to .env and fill in the credentials you have.
# OpenVox runs entirely on your machine. None of these keys leave your box.

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
CORE_PORT=8000
SERVER_PORT=3001
DASHBOARD_PORT=3000

# ── Network / TLS ──────────────────────────────────────────────────────────
# If you're behind a corporate TLS-inspection proxy (Zscaler, Palo Alto, etc.)
# every outbound HTTPS will fail with "unable to get local issuer certificate".
# Two options:
#   1) Drop your corporate root PEM into ./docker/extra-ca.pem and restart.
#      OpenVox will trust it automatically.
#   2) Set OPENVOX_INSECURE_TLS=true to skip verification entirely (only safe
#      on networks you control — emits a loud warning in the core logs).
OPENVOX_INSECURE_TLS=false

# ── Storage (local-first defaults to SQLite + filesystem) ──────────────────
# DATABASE_URL=sqlite+aiosqlite:///./.openvox/openvox.db   # default for `dev`
DATABASE_URL=postgresql+asyncpg://openvox:openvox@localhost:5432/openvox
REDIS_URL=redis://localhost:6379

# ── Auth (only used if you expose OpenVox over the network) ────────────────
# Local-first mode skips auth. Set OPENVOX_AUTH=enabled to require it.
OPENVOX_AUTH=disabled
JWT_SECRET=change-me-locally-or-use-openssl-rand-base64-64
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── BytePlus (default provider stack) ──────────────────────────────────────
# LLM (Ark / Seed-2.0) — different key than the voice key below.
# Get from: https://console.byteplus.com/  → ModelArk → API Keys
BYTEPLUS_LLM_API_KEY=
# Optional: a deployed inference endpoint id (ep-xxxxx) overrides the model id
BYTEPLUS_LLM_ENDPOINT_ID=
# Default model when no endpoint id is set.
BYTEPLUS_LLM_MODEL=seed-2-0-pro-260328
# Region: international (ap-southeast) | china (cn-beijing).
BYTEPLUS_LLM_REGION=ap-southeast
# Embedding model used by the Document Q&A agent.
BYTEPLUS_EMBEDDING_MODEL=doubao-embedding-large-text-240915
# Optional: BytePlus RAG Cloud (managed knowledge base). Leave blank to
# keep using the local in-DB vector store. Authenticates with AK + SK
# (HMAC-SHA256 signed requests, NOT a Bearer token).
# Docs:
#   https://docs.byteplus.com/en/docs/RAG_Cloud/Signature_authentication_and_examples
#   https://docs.byteplus.com/en/docs/RAG_Cloud/collection_create
#   https://docs.byteplus.com/en/docs/RAG_Cloud/collection_service_chat
BYTEPLUS_RAG_ACCESS_KEY=
BYTEPLUS_RAG_SECRET_KEY=
BYTEPLUS_RAG_COLLECTION=
BYTEPLUS_RAG_ENDPOINT=https://api-knowledgebase.mlp.cn-hongkong.bytepluses.com
BYTEPLUS_RAG_REGION=cn-hongkong
BYTEPLUS_RAG_SERVICE=air

# Voice (Seed-Speech 2.0 — TTS + ASR) — separate key from LLM.
# Get from: speech.byteplus.com console.
BYTEPLUS_VOICE_API_KEY=
# OpenVox uses Seed-Speech 2.0 (X-Api-Resource-Id: seed-tts-2.0). The voice
# below MUST be one your BytePlus key has activated in the console.
# Browse and activate voices at:
#   https://docs.byteplus.com/en/docs/byteplusvoice/voicelist
BYTEPLUS_TTS_DEFAULT_VOICE=en_male_tim_uranus_bigtts

# RTC — for browser-based real-time voice rooms.
# Get from: https://console.byteplus.com/ → RTC → AppID
BYTEPLUS_RTC_APP_ID=
BYTEPLUS_RTC_APP_KEY=

# ── LLM providers (optional) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ── STT providers (optional) ───────────────────────────────────────────────
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
# Whisper: uses OPENAI_API_KEY above, or set WHISPER_MODE=local
WHISPER_MODE=api

# ── TTS providers (optional) ───────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
CARTESIA_API_KEY=
CARTESIA_DEFAULT_VOICE_ID=
# OpenAI TTS uses OPENAI_API_KEY above
OPENAI_TTS_DEFAULT_VOICE=alloy

# ── Telephony ──────────────────────────────────────────────────────────────
# Twilio — for phone calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Meta WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Telegram bot — set per-agent via dashboard wizard; the env var is
# only used as a fallback for single-agent deploys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Public webhook URL (ngrok tunnel, opt-in) ──────────────────────────────
# Required if you want to receive telephony webhooks (Twilio inbound,
# Telegram, WeChat, Lark) on a machine that isn't directly internet-exposed.
# Free signup at https://ngrok.com gives you an authtoken; then start the
# stack with `docker compose --profile tunnel up` to bring up the sidecar.
NGROK_AUTHTOKEN=

# ── Object storage (audio recordings, transcripts) ─────────────────────────
# Backend: local | byteplus_tos | s3 | gcs | alibaba_oss
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./.openvox/storage

# BytePlus TOS
BYTEPLUS_TOS_ACCESS_KEY=
BYTEPLUS_TOS_SECRET_KEY=
BYTEPLUS_TOS_ENDPOINT=tos-ap-southeast-1.bytepluses.com
BYTEPLUS_TOS_REGION=ap-southeast-1
BYTEPLUS_TOS_BUCKET=openvox-media

# AWS S3 / MinIO
S3_BUCKET=openvox-media
S3_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage
GCS_BUCKET=
GCS_CREDENTIALS_JSON=

# Alibaba OSS
ALIBABA_OSS_BUCKET=
ALIBABA_OSS_ENDPOINT=
ALIBABA_OSS_ACCESS_KEY_ID=
ALIBABA_OSS_ACCESS_KEY_SECRET=

# ── Routing & policy ───────────────────────────────────────────────────────
# Strategy: latency | cost | quality | round_robin | sticky
ROUTING_STRATEGY=latency
ROUTING_FALLBACK_ENABLED=true
LATENCY_BUDGET_MS=300

# ── Privacy / GDPR ─────────────────────────────────────────────────────────
DATA_RETENTION_DAYS=30
ENABLE_TRANSCRIPT_STORAGE=true
ENABLE_AUDIO_STORAGE=false
PII_MASKING_ENABLED=true
DATA_RESIDENCY_REGION=ap-southeast-1

# ── Observability (optional) ───────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
