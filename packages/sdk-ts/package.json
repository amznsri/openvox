{
  "name": "@openvox/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for OpenVox — build voice agents from your app.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "ws": "^8.18.0" },
  "peerDependencies": {},
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.2"
  }
}
