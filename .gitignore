# Claude Code — per-developer local config (launch.json for the preview
# server, settings.local.json for permission grants). These shouldn't
# travel with the repo; each contributor's setup is their own.
.claude/

# Local data (local-first)
data/
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Docker volumes (when bind-mounted)
.docker-data/

# OpenVox local state directory
.openvox/
/packages/core/openvox/_dashboard/*
!/packages/core/openvox/_dashboard/.gitkeep

# Next.js / npm — auto-generated, not source
apps/dashboard/next-env.d.ts
apps/dashboard/package-lock.json

# Internal-only working files. CLAUDE.md (project memory for the
# coding agent) and docs/ (planning notes, session logs, internal
# READMEs) are maintained in the local clone but NOT pushed to
# GitHub. The repo's public surface stays code + the top-level
# README + LICENSE.
CLAUDE.md
docs/
